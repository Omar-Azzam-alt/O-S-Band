<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OBB Sentinel — Lab Companion"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/inputUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Host URL (http://192.168.1.4:5000)"
            android:inputType="textUri"
            android:text="http://192.168.1.4:5000"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/inputToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Lab API Token"
            android:inputType="text"
            android:text="isef-lab-token"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/inputNtfy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ntfy Command Fallback URL"
            android:inputType="textUri"
            android:text="https://ntfy.sh/oob-breaker-8779-cmd"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnSaveSync"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save &amp; Sync"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnDemoMode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Demo Sample"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtTelemetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:padding="12dp"
            android:text="Status: Waiting to sync..."
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnCont"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Resume (CONT)"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnKill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kill (KILL)"
                android:backgroundTint="#B91C1C"
                android:textColor="#FFFFFF"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/inputPhase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phase"
            android:text="Phase 2 - Physical UART"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <EditText
                android:id="@+id/inputTime90"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Sec to 90%"
                android:inputType="numberDecimal"
                android:text="14.5"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/inputFreezeMs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Freeze ms"
                android:inputType="numberDecimal"
                android:text="185"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/inputNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Trial notes"
            android:text="90.0% RAM tripwire -> SIGSTOP -> vault 0444"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnLogTrial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save Trial"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnShareCsv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Share CSV"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtDossiersAndTrials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0F172A"
            android:padding="12dp"
            android:text="Vault &amp; Trials log will appear here."
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
